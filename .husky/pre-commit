#!/usr/bin/env sh
# Many GUI git clients (IDE integrations, GitHub Desktop, etc.) launch with a
# minimal PATH that doesn't include user-installed runtime dirs. Prepend the
# common ones so Node/npm are findable regardless of how git is invoked.
export PATH="$HOME/.local/bin:/opt/homebrew/opt/node@24/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

npx --no-install lint-staged
